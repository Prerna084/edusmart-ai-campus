{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask backend",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "python": "${workspaceFolder}/backend/venv/bin/python",
      "args": ["run", "--no-debugger", "--no-reload"],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "FLASK_APP": "run.py",
        "PYTHONPATH": "${workspaceFolder}/backend"
      }
    }
  ]
}